<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.vulinh</groupId>
        <artifactId>spring-base-parent</artifactId>
        <version>1.0.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <artifactId>spring-base</artifactId>
    <version>3.0.0-alpha</version>
    <name>Spring Base project</name>
    <description>Your dumb comments go boom!</description>

    <properties>
        <!-- CVE Fixes: START -->

        <!-- https://mvnrepository.com/artifact/org.apache.commons/commons-lang3/versions -->
        <commons-lang3.version>3.20.0</commons-lang3.version>

        <!-- https://mvnrepository.com/artifact/commons-io/commons-io/versions -->
        <commons-io.version>2.22.0</commons-io.version>

        <!-- https://mvnrepository.com/artifact/org.apache.commons/commons-collections4/versions -->
        <commons-collections4.version>4.5.0</commons-collections4.version>

        <!-- https://mvnrepository.com/artifact/io.netty/netty-codec/versions -->
        <netty.version>4.2.13.Final</netty.version>

        <!-- CVE Fixes: END -->

        <!-- https://mvnrepository.com/artifact/com.google.guava/guava -->
        <guava.version>33.6.0-jre</guava.version>

        <!-- https://mvnrepository.com/artifact/com.sanctionco.jmail/jmail -->
        <jmail.version>2.1.0</jmail.version>

        <!-- https://mvnrepository.com/artifact/org.jsoup/jsoup -->
        <jsoup.version>1.22.2</jsoup.version>

        <!-- https://mvnrepository.com/artifact/org.commonmark/commonmark/versions -->
        <commonmark.version>0.28.0</commonmark.version>
    </properties>

    <dependencies>
        <!-- BEGIN: Spring Base -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-stream-rabbit</artifactId>
        </dependency>
        <!-- END: Spring Base -->

        <!-- BEGIN: PostgreSQL-->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- END: PostgreSQL-->

        <!-- BEGIN: Liquibase -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>
        <!-- END: Liquibase -->

        <!-- BEGIN: JMail validation library -->
        <dependency>
            <groupId>com.sanctionco.jmail</groupId>
            <artifactId>jmail</artifactId>
            <version>${jmail.version}</version>
        </dependency>
        <!-- END: JMail validation library -->

        <!-- BEGIN: Google Guava -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>${guava.version}</version>
        </dependency>
        <!-- END: Google Guava -->

        <!-- BEGIN: JSoup -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>
        <!-- END: JSoup -->

        <!-- BEGIN: CommonMark (Markdown → HTML, used for sanitization validation) -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>${commonmark.version}</version>
        </dependency>
        <!-- END: CommonMark -->

        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons-io.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>${commons-collections4.version}</version>
        </dependency>

        <!-- https://mvnrepository.com/artifact/com.github.ben-manes.caffeine/caffeine/versions -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${caffeine.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>app</finalName>
    </build>
</project>
